+// Mensajes de casa para Julia: uno cada día, sin repetir hasta completar los 100.
+// Archivo generado a partir del documento "Mensajes de casa – Mamá e Ivi".
+
+export type FamilyMessageCategory = 'Orgullo' | 'Motivación' | 'Nostalgia' | 'Confianza' | 'Descanso' | 'Vocación enfermera' | 'Familia';
+
+export interface FamilyMessage {
+  id: number;
+  category: FamilyMessageCategory;
+  icon?: string;
+  text: string;
+  signature: string;
+}
+
+export const FAMILY_MESSAGES: FamilyMessage[] = [
+  { id: 1, category: "Orgullo", text: "Estamos inmensamente orgullosos de ti, de tu esfuerzo y de la ilusión con la que estás construyendo tu futuro. Nunca olvides lo mucho que vales y lo lejos que puedes llegar.", signature: "Con todo nuestro amor, Mamá e Ivi. Desde Granada. ❤️" },
+  { id: 2, category: "Orgullo", text: "Cada vez que pensamos en ti y en todo lo que estás consiguiendo, se nos llena el corazón de orgullo. Eres una chica maravillosa y tienes un futuro precioso por delante.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 3, category: "Orgullo", text: "No solo estamos orgullosos de la estudiante en la que te estás convirtiendo, sino también de la persona que eres. Nunca pierdas esa bondad y esa sensibilidad tan tuyas.", signature: "Un beso enorme de Mamá e Ivi." },
+  { id: 4, category: "Orgullo", text: "Has tenido la valentía de salir de casa, empezar una nueva etapa y luchar por tus sueños. Eso ya dice muchísimo de ti. ¡Estamos orgullosísimos!", signature: "Con un abrazo de los que no caben en un mensaje. Mamá e Ivi." },
+  { id: 5, category: "Orgullo", text: "Ojalá pudieras verte con nuestros ojos para comprender lo especial que eres y lo orgullosos que nos sentimos de tenerte en nuestras vidas.", signature: "Te queremos hasta el infinito. Mamá e Ivi." },
+  { id: 6, category: "Orgullo", text: "Cada examen, cada práctica y cada hora de estudio son pequeñas victorias que te acercan a tu sueño. Nosotros celebramos cada una de ellas contigo.", signature: "Siempre en tu equipo. Mamá e Ivi." },
+  { id: 7, category: "Orgullo", text: "Estás construyendo tu futuro con esfuerzo, valentía y mucha ilusión. Nunca dudes de lo orgullosos que estamos de ti.", signature: "Un beso enorme desde Granada. Mamá e Ivi." },
+  { id: 8, category: "Orgullo", text: "Qué bonito es verte luchar por aquello que te hace feliz. Sigue siendo esa persona trabajadora, cariñosa y llena de luz que tanto queremos.", signature: "Con todo nuestro cariño. Mamá, Ivi, Lucía y Laura." },
+  { id: 9, category: "Orgullo", text: "No hace falta que consigas grandes cosas todos los días para hacernos sentir orgullosos. Nos basta con saber que eres feliz, que luchas por tus sueños y que sigues siendo tú.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 10, category: "Orgullo", text: "Algún día mirarás atrás y recordarás todo lo que has tenido que esforzarte para llegar a donde querías. Y nosotros estaremos ahí, recordándote que siempre supimos que podías conseguirlo.", signature: "Con muchísimo orgullo. Mamá e Ivi." },
+  { id: 11, category: "Orgullo", text: "Tu independencia, tu constancia y tu manera de afrontar esta etapa nos demuestran cada día lo mucho que estás creciendo. ¡Qué suerte tenemos de tenerte!", signature: "Un abrazo familiar desde Granada. ❤️" },
+  { id: 12, category: "Orgullo", text: "Estamos deseando verte con tu uniforme de enfermera, pero estamos todavía más orgullosos de la persona que eres hoy. Sigue creciendo sin perder tu esencia.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 13, category: "Orgullo", text: "Hay muchas razones para estar orgullosos de ti, pero una de nuestras favoritas es ver cómo persigues tus sueños sin dejar de tener un corazón enorme.", signature: "Te mandan muchos besos Mamá e Ivi." },
+  { id: 14, category: "Orgullo", text: "Cada pequeño paso que das tiene un valor enorme. No subestimes tu esfuerzo: estás haciendo algo maravilloso por tu futuro.", signature: "Siempre orgullosos de ti. Mamá e Ivi." },
+  { id: 15, category: "Orgullo", text: "Nos hace muy felices saber que estás encontrando tu propio camino. Sigue aprendiendo, descubriendo y disfrutando de esta etapa. ¡Te mereces todo lo bonito que está por llegar!", signature: "Con amor, Mamá, Ivi, Lucía, Laura y Martín." },
+  { id: 16, category: "Orgullo", text: "No eres consciente de lo mucho que nos alegra verte crecer, tomar decisiones y luchar por tus objetivos. Sigue adelante, que aquí tienes una familia que cree en ti.", signature: "Un beso enorme. Mamá e Ivi." },
+  { id: 17, category: "Orgullo", text: "Estamos orgullosos de tus notas, pero mucho más de tu esfuerzo. Los resultados son importantes, pero la persona en la que te estás convirtiendo lo es todavía más.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 18, category: "Orgullo", text: "Tu futuro está lleno de posibilidades y nos encanta saber que estás trabajando para conseguirlo. Nunca dejes de creer en todo lo que eres capaz de hacer.", signature: "Con todo nuestro cariño. Mamá e Ivi." },
+  { id: 19, category: "Orgullo", text: "Siéntete orgullosa de ti misma. Has conseguido mucho, has superado dificultades y sigues avanzando. Nosotros ya lo estamos por ti.", signature: "Un abrazo de toda la familia." },
+  { id: 20, category: "Orgullo", text: "Hoy queremos recordarte que eres uno de nuestros mayores motivos de felicidad. Verte luchar por tu sueño es un regalo. ¡Te queremos, hija!", signature: "Con todo nuestro amor, Mamá e Ivi." },
+  { id: 21, category: "Motivación", text: "Un día más, un paso más cerca de tu sueño. No mires todo lo que queda por estudiar; piensa en todo lo que ya has aprendido. ¡Tú puedes!", signature: "Mamá e Ivi te mandamos toda nuestra energía." },
+  { id: 22, category: "Motivación", text: "Hoy es una nueva oportunidad para aprender algo, superar un reto y demostrarte lo capaz que eres. ¡A por el día, futura enfermera!", signature: "Un beso enorme desde Granada." },
+  { id: 23, category: "Motivación", text: "Los grandes sueños no se consiguen de golpe, sino con pequeños esfuerzos diarios. Sigue trabajando con ilusión y verás hasta dónde puedes llegar.", signature: "Siempre contigo. Mamá e Ivi." },
+  { id: 24, category: "Motivación", text: "Que las ganas de conseguir tu sueño sean siempre más grandes que las dificultades del camino. ¡Confía en ti y sigue adelante!", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 25, category: "Motivación", text: "No necesitas tener un día perfecto para avanzar. A veces basta con estudiar un tema, entender algo nuevo o simplemente no rendirse.", signature: "Muchísimo ánimo. Mamá, Ivi y Martín." },
+  { id: 26, category: "Motivación", text: "Cada página que estudias, cada práctica y cada clase tienen un propósito. Estás preparando tu futuro y eso merece todo tu esfuerzo.", signature: "Con mucho cariño. Mamá e Ivi." },
+  { id: 27, category: "Motivación", text: "Cuando algo te parezca difícil, divídelo en pequeños pasos. No tienes que conseguirlo todo hoy. Solo tienes que empezar.", signature: "¡Vamos, campeona! Mamá e Ivi." },
+  { id: 28, category: "Motivación", text: "Que hoy no te falten concentración para estudiar, paciencia para aprender y motivos para sonreír. ¡Un día más construyendo tu sueño!", signature: "Besos de toda la familia." },
+  { id: 29, category: "Motivación", text: "No te compares con nadie. Tu camino es tuyo, tu ritmo es válido y tus logros tienen un valor enorme. Sigue avanzando a tu manera.", signature: "Con todo nuestro apoyo. Mamá e Ivi." },
+  { id: 30, category: "Motivación", text: "La futura enfermera que quieres ser se construye con la estudiante que eres hoy. Cada esfuerzo cuenta. ¡Estamos contigo!", signature: "Te mandamos un abrazo enorme. Mamá e Ivi." },
+  { id: 31, category: "Motivación", text: "Hoy puede ser un gran día. Levántate con ilusión, confía en tus capacidades y recuerda que tienes una familia entera animándote desde Granada.", signature: "Con amor. Mamá, Ivi, Lucía y Laura." },
+  { id: 32, category: "Motivación", text: "Los retos no están para demostrarte que no puedes, sino para descubrirte todo lo que eres capaz de superar. ¡Adelante!", signature: "Siempre en tu equipo. Mamá e Ivi." },
+  { id: 33, category: "Motivación", text: "No dejes que el miedo a equivocarte te impida intentarlo. Aprender también significa preguntar, fallar, corregir y volver a empezar.", signature: "Un beso enorme. Mamá e Ivi." },
+  { id: 34, category: "Motivación", text: "Tienes talento, tienes capacidad y tienes una vocación preciosa. Ahora toca seguir alimentándola con ilusión y constancia. ¡A por todas!", signature: "Con muchísimo cariño. Mamá e Ivi." },
+  { id: 35, category: "Motivación", text: "Hoy no necesitas conquistar el mundo. Solo dar lo mejor de ti, disfrutar de lo que puedas y terminar el día sabiendo que lo has intentado.", signature: "Te queremos. Mamá e Ivi." },
+  { id: 36, category: "Nostalgia", text: "Aunque estés en Toledo y nosotros en Granada, hay algo que nunca cambia: nuestro amor por ti. Estamos contigo en cada paso, aunque no podamos darte un abrazo cada día.", signature: "Te quieren muchísimo, Mamá e Ivi." },
+  { id: 37, category: "Nostalgia", text: "Hoy en casa nos acordamos mucho de ti. Seguro que Pongo también se alegraría muchísimo de verte aparecer por la puerta. ¡Te mandamos un montón de besos!", signature: "De parte de Mamá, Ivi y Pongo. 🐶" },
+  { id: 38, category: "Nostalgia", text: "Aquí tienes una familia que te echa de menos, que habla de ti y que se siente feliz cada vez que sabe que estás bien. Nunca olvides que tienes tu casa esperándote.", signature: "Con amor, Mamá e Ivi." },
+  { id: 39, category: "Nostalgia", text: "Lucía y Laura también tienen muchas ganas de darte un abrazo. Y Martín seguro que tiene mil cosas que contarte. ¡Aquí todos te queremos y te echamos de menos!", signature: "Un beso de Mamá, Ivi y tus hermanos." },
+  { id: 40, category: "Nostalgia", text: "Si hoy echas de menos casa, imagina que estamos todos alrededor de la mesa, hablando, riendo y disfrutando de estar juntos. Pronto volveremos a compartir esos momentos.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 41, category: "Nostalgia", text: "Desde Granada te mandamos un abrazo de esos que duran mucho y que no necesitan palabras. Cierra los ojos e imagina que estamos ahí contigo.", signature: "Te quieren, Mamá e Ivi." },
+  { id: 42, category: "Nostalgia", text: "Tati y Leo seguramente no entienden muy bien dónde estás, pero estamos seguros de que también les gustaría tenerte por aquí para recibir sus mimos.", signature: "Ronroneos y cariño de Mamá, Ivi, Tati y Leo. 🐱" },
+  { id: 43, category: "Nostalgia", text: "La distancia nos separa durante la semana, pero seguimos compartiendo las mismas ganas de verte feliz. Toledo es tu etapa de ahora, pero Granada siempre será uno de tus hogares.", signature: "Con amor infinito. Mamá e Ivi." },
+  { id: 44, category: "Nostalgia", text: "Ojalá hoy pudiéramos prepararte algo rico, sentarnos contigo y preguntarte cómo te ha ido el día. Mientras tanto, te mandamos un beso enorme.", signature: "Con todo nuestro cariño. Mamá e Ivi." },
+  { id: 45, category: "Nostalgia", text: "Martín dice que le debes un abrazo cuando vuelvas. Y nosotros también. ¡Que no se te olvide que aquí tienes a una familia que te adora!", signature: "De parte de Mamá, Ivi, Lucía, Laura y Martín." },
+  { id: 46, category: "Nostalgia", text: "A veces las personas que queremos están lejos, pero basta pensar en ellas para sentirlas cerca. Nosotros pensamos en ti todos los días.", signature: "Un abrazo enorme desde casa. Mamá e Ivi." },
+  { id: 47, category: "Nostalgia", text: "Hay un sitio en Granada donde siempre tendrás una sonrisa esperándote, un abrazo preparado y muchas ganas de escuchar tus historias. ¡Te queremos!", signature: "Mamá e Ivi." },
+  { id: 48, category: "Nostalgia", text: "Hoy Pongo, Tati y Leo tienen una misión: recordarte que en casa hay tres compañeros peludos que también forman parte de tu familia y que seguro agradecerían tus mimos.", signature: "Con cariño, Mamá, Ivi y la pandilla peluda. 🐶🐱" },
+  { id: 49, category: "Nostalgia", text: "No importa cuántos kilómetros haya entre Toledo y Granada. Siempre estaremos a una llamada, un mensaje o un abrazo de distancia cuando nos necesites.", signature: "Siempre contigo. Mamá e Ivi." },
+  { id: 50, category: "Nostalgia", text: "Disfruta de tu independencia, de tus amigos y de todo lo bonito que estás viviendo. Pero recuerda que aquí tienes un hogar al que siempre puedes regresar.", signature: "Te queremos con locura. Mamá e Ivi." },
+  { id: 51, category: "Confianza", text: "Confía en ti tanto como nosotros confiamos en ti. Tienes inteligencia, sensibilidad y capacidad para convertirte en una enfermera extraordinaria.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 52, category: "Confianza", text: "No permitas que un examen difícil o una mala nota te hagan dudar de todo lo que vales. Un resultado no define quién eres ni hasta dónde puedes llegar.", signature: "Estamos contigo. Mamá e Ivi." },
+  { id: 53, category: "Confianza", text: "No tienes que saberlo todo ni hacerlo todo bien a la primera. Estás estudiando precisamente para aprender. Ten paciencia contigo misma.", signature: "Un abrazo enorme. Mamá e Ivi." },
+  { id: 54, category: "Confianza", text: "Tienes mucho más potencial del que a veces imaginas. No dejes que las dudas hablen más alto que tus ganas de conseguirlo.", signature: "Creemos en ti. Mamá e Ivi." },
+  { id: 55, category: "Confianza", text: "Recuerda todas las veces que pensaste que algo era demasiado difícil y finalmente lo conseguiste. Esa misma fuerza sigue dentro de ti.", signature: "Con mucho cariño. Mamá e Ivi." },
+  { id: 56, category: "Confianza", text: "No necesitas demostrar constantemente que eres capaz. Ya lo eres. Sigue aprendiendo, creciendo y confiando en tu propio camino.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 57, category: "Confianza", text: "Equivocarse no te hace menos válida. Reconocerlo, aprender y mejorar es lo que te hará crecer como estudiante y como futura profesional.", signature: "Siempre orgullosos de ti. Mamá e Ivi." },
+  { id: 58, category: "Confianza", text: "No dejes que los nervios te hagan olvidar todo lo que has preparado. Respira, organiza tus ideas y confía en tu trabajo.", signature: "¡Tú puedes! Mamá, Ivi y tus hermanos." },
+  { id: 59, category: "Confianza", text: "Tienes derecho a preguntar, a tener dudas y a necesitar ayuda. Nadie lo sabe todo. La humildad también es una gran cualidad profesional.", signature: "Un beso de Mamá e Ivi." },
+  { id: 60, category: "Confianza", text: "No midas tu valor por las notas que consigas. Eres una persona maravillosa mucho antes de conseguir cualquier título.", signature: "Te queremos por quien eres. Mamá e Ivi." },
+  { id: 61, category: "Confianza", text: "Cuando dudes de ti, recuerda que nosotros nunca dudamos de la maravillosa persona que eres. Sigue adelante, que tienes muchísimo que ofrecer.", signature: "Con todo nuestro cariño. Mamá e Ivi." },
+  { id: 62, category: "Confianza", text: "No te asustes ante lo nuevo. Cada experiencia te hará más segura, más preparada y más consciente de tus capacidades.", signature: "Siempre a tu lado. Mamá e Ivi." },
+  { id: 63, category: "Confianza", text: "Tienes permiso para no tenerlo todo claro, para cambiar de opinión y para aprender a tu ritmo. Lo importante es que sigas escuchándote.", signature: "Un abrazo enorme. Mamá e Ivi." },
+  { id: 64, category: "Confianza", text: "Nunca olvides que eres mucho más que una estudiante de enfermería. Eres una persona única, querida y valiosa, y eso no depende de ningún examen.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 65, category: "Confianza", text: "Mira todo lo que has conseguido hasta ahora. Si has llegado hasta aquí, es porque tienes la capacidad y la determinación necesarias para seguir avanzando.", signature: "Con orgullo y confianza en ti. Mamá e Ivi." },
+  { id: 66, category: "Descanso", icon: "🌧️", text: "Hoy queremos recordarte que no tienes que poder con todo. Si estás cansada, descansa. El mundo puede esperar un poquito. Tu bienestar es lo primero.", signature: "Te mandamos un abrazo enorme. Mamá e Ivi." },
+  { id: 67, category: "Descanso", icon: "🌧️", text: "Un mal día no significa una mala vida, ni un mal examen significa un mal futuro. Mañana será otra oportunidad. Hoy sé amable contigo misma.", signature: "Siempre estaremos aquí. Mamá e Ivi." },
+  { id: 68, category: "Descanso", icon: "🌧️", text: "No tienes que ser perfecta, hija. Solo tienes que ser tú, con tus aciertos, tus errores y tus ganas de seguir aprendiendo. Para nosotros ya eres maravillosa.", signature: "Te queremos tal y como eres. Mamá e Ivi." },
+  { id: 69, category: "Descanso", icon: "🌧️", text: "Si hoy sientes que todo pesa demasiado, deja los apuntes un rato, respira y haz algo que te haga feliz. Descansar también forma parte del camino.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 70, category: "Descanso", icon: "🌧️", text: "Si necesitas llorar, llora. Si necesitas hablar, llámanos. Si necesitas silencio, descansa. No tienes que esconder cómo te sientes con nosotros.", signature: "Aquí tienes siempre tu refugio. Mamá e Ivi." },
+  { id: 71, category: "Descanso", icon: "🌧️", text: "No te castigues por no llegar a todo. Has elegido un camino exigente y estás haciendo lo que puedes. Eso también merece reconocimiento.", signature: "Un beso muy grande. Mamá e Ivi." },
+  { id: 72, category: "Descanso", icon: "🌧️", text: "Hoy no queremos que estudies más ni que consigas nada especial. Solo queremos que estés bien, que te cuides y que recuerdes lo muchísimo que te queremos.", signature: "Con todo nuestro cariño. Mamá e Ivi." },
+  { id: 73, category: "Descanso", icon: "🌧️", text: "Si alguna vez sientes que no puedes más, recuerda que pedir ayuda no es una debilidad. Tienes una familia que te escucha sin juzgarte.", signature: "Para lo que necesites, aquí estamos. Mamá e Ivi." },
+  { id: 74, category: "Descanso", icon: "🌧️", text: "No conviertas cada descanso en un sentimiento de culpa. Necesitas dormir, comer bien, reírte y disfrutar. También así te preparas para ser una buena profesional.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 75, category: "Descanso", icon: "🌧️", text: "Hoy te damos permiso para ir más despacio. No tienes que demostrar nada, no tienes que llegar a todo y no tienes que ser fuerte constantemente.", signature: "Un abrazo de los que curan el alma. Mamá e Ivi." },
+  { id: 76, category: "Descanso", icon: "🌧️", text: "Cuando tengas uno de esos días grises, recuerda que incluso los días más difíciles terminan. No estás sola y no tienes que enfrentarte a todo sin apoyo.", signature: "Te mandamos todo nuestro cariño. Mamá e Ivi." },
+  { id: 77, category: "Descanso", icon: "🌧️", text: "Una nota no vale más que tu tranquilidad. Una práctica no vale más que tu salud. Y ninguna dificultad cambia lo muchísimo que te queremos.", signature: "Siempre estaremos de tu lado. Mamá e Ivi." },
+  { id: 78, category: "Descanso", icon: "🌧️", text: "Si hoy necesitas desconectar de la universidad, hazlo sin remordimientos. Sal a pasear, escucha música, habla con alguien que te haga sonreír. También necesitas vivir.", signature: "Muchos besos. Mamá, Ivi y Martín." },
+  { id: 79, category: "Descanso", icon: "🌧️", text: "No tienes que llevar siempre una sonrisa puesta. Puedes tener días malos, sentirte vulnerable y necesitar un abrazo. Nosotros te queremos en todas tus versiones.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 80, category: "Descanso", icon: "🌧️", text: "Recuerda algo importante: la carrera es una parte de tu vida, no toda tu vida. Tu felicidad, tus sueños y tu tranquilidad también cuentan.", signature: "Te queremos hasta el infinito. Mamá e Ivi." },
+  { id: 81, category: "Vocación enfermera", text: "La enfermería necesita personas que sepan cuidar con conocimiento, pero también con humanidad. Nunca pierdas esa sensibilidad tan bonita que tienes.", signature: "Estamos orgullosos de tu vocación. Mamá e Ivi." },
+  { id: 82, category: "Vocación enfermera", text: "Algún día una persona se sentirá más tranquila simplemente porque tú estás a su lado. Ese será uno de los regalos más bonitos de tu profesión.", signature: "Con muchísimo cariño. Mamá e Ivi." },
+  { id: 83, category: "Vocación enfermera", text: "No olvides que detrás de cada paciente hay una persona con miedos, sentimientos y una historia. Tu empatía puede marcar una diferencia enorme.", signature: "Un beso de Mamá e Ivi." },
+  { id: 84, category: "Vocación enfermera", text: "Estás aprendiendo una profesión en la que la ciencia y el corazón caminan juntos. Cultiva ambos y llegarás a ser una gran enfermera.", signature: "Con orgullo. Mamá e Ivi." },
+  { id: 85, category: "Vocación enfermera", text: "Una palabra amable, una explicación tranquila o una mano tendida pueden significar muchísimo para alguien que lo está pasando mal. Nunca subestimes esos pequeños gestos.", signature: "Te queremos muchísimo. Mamá e Ivi." },
+  { id: 86, category: "Vocación enfermera", text: "Ojalá nunca pierdas la ilusión que te llevó a elegir enfermería. Que el conocimiento te haga buena profesional y la humanidad te haga inolvidable.", signature: "Con todo nuestro amor. Mamá e Ivi." },
+  { id: 87, category: "Vocación enfermera", text: "Cada clase que recibes y cada práctica que realizas te preparan para algo precioso: cuidar de las personas cuando más lo necesitan.", signature: "Mucho ánimo, futura enfermera. Mamá e Ivi." },
+  { id: 88, category: "Vocación enfermera", text: "Ser una gran enfermera no significa saberlo todo, sino tener ganas de aprender, responsabilidad para actuar y humildad para pedir ayuda.", signature: "Estamos contigo. Mamá e Ivi." },
+  { id: 89, category: "Vocación enfermera", text: "Nunca olvides que cuidar también significa escuchar, respetar y acompañar. Tu manera de tratar a las personas será tan importante como tus conocimientos.", signature: "Con cariño. Mamá e Ivi." },
+  { id: 90, category: "Vocación enfermera", text: "Qué bonito es poder dedicar tu vida a una profesión que ayuda a los demás. Sigue formándote con ilusión y nunca pierdas el sentido de lo que haces.", signature: "Te mandamos un beso enorme. Mamá e Ivi." },
+  { id: 91, category: "Vocación enfermera", text: "Algún día recordarás estos apuntes, estas prácticas y estos exámenes mientras estés cuidando a tus propios pacientes. Todo este esfuerzo tendrá un sentido precioso.", signature: "Con mucho orgullo. Mamá e Ivi." },
+  { id: 92, category: "Vocación enfermera", text: "La técnica se aprende, los conocimientos se adquieren y la experiencia llega con los años. Pero la humanidad con la que cuidas es algo que debes conservar siempre.", signature: "Te queremos. Mamá e Ivi." },
+  { id: 93, category: "Vocación enfermera", text: "Ojalá tus futuros pacientes encuentren en ti a una profesional que transmita seguridad, confianza y cariño. Estamos seguros de que tienes mucho que ofrecer.", signature: "Con todo nuestro apoyo. Mamá e Ivi." },
